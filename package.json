{
  "name": "dsh-plastic-memory",
  "version": "0.2.0-beta.1",
  "description": "Memory plugin with built-in governance for DeepSeek Harness",
  "license": "MIT",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "agent-memory",
    "memory",
    "llm",
    "plastic-memory"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/KKL08/dsh-plastic-memory.git"
  },
  "homepage": "https://github.com/KKL08/dsh-plastic-memory#readme",
  "type": "module",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "main": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./client": "./lib/client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "publishConfig": {
    "main": "lib/index.js",
    "exports": {
      ".": "./lib/index.js",
      "./client": "./lib/client.js",
      "./package.json": "./package.json",
      "./locale/*.json": "./locale/*.json"
    }
  },
  "files": [
    "lib",
    "locale",
    "cordis.patch.yml",
    "README.md"
  ],
  "dependencies": {
    "yaml": "^2.9.0",
    "zod": "^4.4.3"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "*",
    "@deepseek-ai/dsh-llm": ">=0.1.7-rc.1",
    "@deepseek-ai/dsh-storage-domain": ">=0.1.7-rc.1",
    "@deepseek-ai/dsh-system-prompt": ">=0.1.7-rc.1",
    "@deepseek-ai/dsh-tools": ">=0.1.7-rc.1",
    "@deepseek-ai/schemastery": "*"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.5",
    "@deepseek-ai/dsh-agent": "0.2.1-rc.2",
    "@deepseek-ai/dsh-agent-instructions": "0.2.1-rc.2",
    "@deepseek-ai/dsh-llm": "0.2.1-rc.2",
    "@deepseek-ai/dsh-session": "0.2.1-rc.2",
    "@deepseek-ai/dsh-session-projection": "0.2.1-rc.2",
    "@deepseek-ai/dsh-storage-domain": "0.2.1-rc.2",
    "@deepseek-ai/dsh-system-prompt": "0.2.1-rc.2",
    "@deepseek-ai/dsh-timeout": "0.2.1-rc.2",
    "@deepseek-ai/dsh-tools": "0.2.1-rc.2",
    "@deepseek-ai/dsh-util-values": "0.2.1-rc.2",
    "@deepseek-ai/schemastery": "3.18.5",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.2.0",
    "@types/react": "^18.3.31",
    "@types/react-dom": "~18.3.7",
    "@vitest/coverage-v8": "3.2.7",
    "esbuild": "^0.28.2",
    "fast-check": "^4.9.0",
    "jsdom": "29.1.1",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "scripts": {
    "build": "rm -rf lib && tsc -p tsconfig.build.json && node scripts/build-client.ts",
    "host:smoke": "bash scripts/host-smoke.sh",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit && tsc --noEmit -p client",
    "host:contract": "bash scripts/host-contract/run.sh",
    "bench:storage": "node scripts/bench-storage.ts",
    "prepublishOnly": "pnpm typecheck && pnpm test && pnpm build",
    "build:client": "node scripts/build-client.ts"
  },
  "packageManager": "pnpm@11.22.0"
}
